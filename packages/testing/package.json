{
  "name": "@clinical-ui/testing",
  "version": "0.1.0-rc.11",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/normalize-esm-specifiers.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@clinical-ui/core": "workspace:*",
    "@clinical-ui/fhir": "workspace:*"
  },
  "description": "Deterministic synthetic FHIR fixtures for Clinical UI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wanecode/clinical-ui.git",
    "directory": "packages/testing"
  },
  "homepage": "https://wanecode.github.io/clinical-ui/",
  "bugs": {
    "url": "https://github.com/wanecode/clinical-ui/issues"
  },
  "keywords": [
    "clinical-ui",
    "fhir",
    "fhir-r5",
    "react",
    "testing"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
